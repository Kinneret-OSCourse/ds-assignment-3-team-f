MULLIGAN_DB_PASSWORD=replace-with-strong-postgres-password
MULLIGAN_REPMGR_PASSWORD=replace-with-strong-replication-password
MULLIGAN_QUEUE_ADMIN_PASSWORD=replace-with-strong-admin-password
MULLIGAN_QUEUE_CUSTOMER_PASSWORD=replace-with-strong-customer-password
MULLIGAN_QUEUE_PEO_PASSWORD=replace-with-strong-peo-password
MULLIGAN_QUEUE_MO_PASSWORD=replace-with-strong-mo-password
MULLIGAN_RABBITMQ_ERLANG_COOKIE=replace-with-a-long-shared-erlang-cookie
MULLIGAN_MESSAGE_HMAC_SECRET=replace-with-at-least-32-random-characters
MULLIGAN_TLS_STORE_PASSWORD=changeit

# Replace with fixed LAN IPs for the six cluster laptops.
LAB_DB1_IP=192.168.1.11
LAB_DB2_IP=192.168.1.12
LAB_DB3_IP=192.168.1.13
LAB_RMQ1_IP=192.168.1.21
LAB_RMQ2_IP=192.168.1.22
LAB_RMQ3_IP=192.168.1.23

# Use these on UI laptops.
MULLIGAN_DB_HOSTS=192.168.1.11:5432,192.168.1.12:5432,192.168.1.13:5432
MULLIGAN_QUEUE_HOSTS=192.168.1.21:5671,192.168.1.22:5671,192.168.1.23:5671
