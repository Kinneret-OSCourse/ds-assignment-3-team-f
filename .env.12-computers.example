MULLIGAN_DB_PASSWORD=replace-with-strong-postgres-password
MULLIGAN_DB_APP_PASSWORD=mulligan_app_pw
MULLIGAN_REPMGR_PASSWORD=replace-with-strong-replication-password

MULLIGAN_QUEUE_ADMIN_PASSWORD=replace-with-strong-admin-password
MULLIGAN_QUEUE_SERVER_PASSWORD=replace-with-strong-server-password
MULLIGAN_QUEUE_CUSTOMER_PASSWORD=replace-with-strong-customer-password
MULLIGAN_QUEUE_PEO_PASSWORD=replace-with-strong-peo-password
MULLIGAN_QUEUE_MO_PASSWORD=replace-with-strong-mo-password
MULLIGAN_RABBITMQ_ERLANG_COOKIE=replace-with-a-long-shared-erlang-cookie

MULLIGAN_HMAC_KEY=replace-with-at-least-32-random-characters
MULLIGAN_TLS_PASSWORD=mulligan_tls_pw
MULLIGAN_QUEUE_TLS=true

LAB_DB1_IP=10.0.201.11
LAB_DB2_IP=10.0.201.12
LAB_DB3_IP=10.0.201.13
LAB_RMQ1_IP=10.0.201.21
LAB_RMQ2_IP=10.0.201.22
LAB_RMQ3_IP=10.0.201.23
LAB_REC1_IP=10.0.201.31
LAB_REC2_IP=10.0.201.32
LAB_REC3_IP=10.0.201.33

MULLIGAN_DB_HOSTS=10.0.201.11:5432,10.0.201.12:5432,10.0.201.13:5432
MULLIGAN_QUEUE_HOSTS=10.0.201.21:5671,10.0.201.22:5671,10.0.201.23:5671
MULLIGAN_RECOMMENDER_ENDPOINTS=http://10.0.201.31:8081,http://10.0.201.32:8082,http://10.0.201.33:8083

# RabbitMQ IPs must be present in the server certificate SANs.
MULLIGAN_TLS_EXTRA_IPS=10.0.201.21,10.0.201.22,10.0.201.23
